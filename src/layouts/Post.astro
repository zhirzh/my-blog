---
import Toc from '@/components/Toc.astro'
import Layout from '@/layouts/Root.astro'
import type { MdLayoutProps } from '@/types'
import { getPost, type Frontmatter } from '@/utils'

type Props = MdLayoutProps<Frontmatter>

const { file, headings } = Astro.props

const post = await getPost(file)
const { nextPost, prevPost } = post
---

<Layout>
   <div
      class='mx-auto grid max-w-5xl gap-x-10 py-30'
      style={{ 'grid-template-columns': 'minmax(0,1fr) 300px' }}
   >
      <article class='prose max-w-none dark:prose-invert'>
         <header>
            <h1>{post.frontmatter.title}</h1>

            <time class='text-sm' datetime={post.frontmatter.date}>
               {post.formattedDate}
            </time>
         </header>

         <slot />

         <footer class='mt-20'>
            <nav class='flex flex-wrap gap-x-10 gap-y-2'>
               {
                  prevPost && (
                     <div>
                        &larr;
                        <a href={prevPost.url}>{prevPost.frontmatter.title}</a>
                     </div>
                  )
               }
               {
                  nextPost && (
                     <div class='ms-auto'>
                        <a href={nextPost.url}>{nextPost.frontmatter.title}</a>
                        &rarr;
                     </div>
                  )
               }
            </nav>
         </footer>
      </article>

      <Toc
         headings={headings}
         class='sticky top-32 prose self-start text-xs leading-relaxed dark:prose-invert'
      />
   </div>
</Layout>
